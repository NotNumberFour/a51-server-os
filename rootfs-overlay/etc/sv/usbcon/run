#!/bin/sh
# Console de emergência: terminal root na porta serial USB (ttyGS0), criada pelo initramfs.
# No Windows aparece como "Dispositivo serial USB (COMx)"; abrir com PuTTY/terminal serial em 115200.
# Exige acesso físico ao cabo, por isso entra direto como root.
exec 2>&1
[ -e /dev/ttyGS0 ] || { sleep 10; exit 1; }
exec /sbin/agetty -L --autologin root 115200 ttyGS0 vt100
